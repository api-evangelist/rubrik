{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rubrik Security Cloud Client Token Oauth API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Oauth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Exchange an authorization code for an access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{rsc_fqdn}/api/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "code",
                  "value": ""
                },
                {
                  "name": "code_verifier",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "redirect_uri",
                  "value": ""
                }
              ]
            }
          },
          "docs": "OAuth2 Authorization Code with PKCE token exchange endpoint."
        }
      ]
    }
  ],
  "bundled": true
}